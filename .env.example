# Copy to .env for local runs (never commit .env). In GitHub these are repository secrets.

# raw files: s3 = Neon Object Storage bucket below, local = raw_data/ in the project
STORAGE=s3
# Neon Console -> Object storage -> weather-raw (endpoint, region); Settings -> Credentials (storage:read + storage:write)
STORAGE_ENDPOINT_URL=https://br-xxxx.storage.c-7.eu-central-1.aws.neon.tech
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=weather-raw

# DWH: Neon Console -> Connect -> direct connection (host without "-pooler")
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require
